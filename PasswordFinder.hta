<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Password Finder Test</title>
  <HTA:APPLICATION
    ID="PasswordFinder"
    APPLICATIONNAME="Password Finder Test"
    BORDER="dialog"
    BORDERSTYLE="normal"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
  />
  <style>
    body { font-family: Segoe UI, Arial, sans-serif; margin: 16px; width: 760px; }
    .row { display: flex; align-items: center; margin-bottom: 10px; gap: 10px; }
    label { min-width: 170px; }
    input[type="text"], input[type="password"], select { width: 520px; padding: 6px; }
    #currentAttempt { width: 700px; }
    .buttons { margin-top: 8px; margin-bottom: 14px; }
    button { padding: 6px 16px; margin-right: 8px; }
    #status { font-weight: 600; }
  </style>
</head>
<body>
  <h2>Password Finder Testprojekt (Windows)</h2>

  <div class="row">
    <label for="passwordInput">Passwort:</label>
    <input id="passwordInput" type="password" />
  </div>

  <div class="row">
    <label for="showPassword">Passwort anzeigen:</label>
    <input id="showPassword" type="checkbox" />
    <span>Sichtbar</span>
  </div>

  <div class="row">
    <label for="charsetSelect">Zeichensystem:</label>
    <select id="charsetSelect"></select>
  </div>

  <div class="buttons">
    <button id="startBtn">Start</button>
    <button id="stopBtn" disabled>Abbrechen</button>
  </div>

  <div class="row"><div id="status">Status: Bereit</div></div>
  <div class="row"><div id="timeLabel">Zeit: 00:00.000</div></div>
  <div class="row"><div id="attemptsLabel">Versuche: 0</div></div>
  <div class="row">
    <label for="currentAttempt">Aktueller Versuch:</label>
    <input id="currentAttempt" type="text" readonly />
  </div>

<script>
(function () {
  var lowercase = "abcdefghijklmnopqrstuvwxyz";
  var uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  var digits = "0123456789";
  var commonSpecials = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";
  var accented = "äöüÄÖÜßàáâãåāçćčèéêëēìíîïīñńòóôõøōùúûüūýÿžźż";

  function uniqueChars(str) {
    var seen = {};
    var out = "";
    for (var i = 0; i < str.length; i++) {
      var ch = str.charAt(i);
      if (!seen[ch]) {
        seen[ch] = true;
        out += ch;
      }
    }
    return out;
  }

  var charsetOptions = [
    { name: "Buchstaben + Zahlen", chars: uniqueChars(lowercase + uppercase + digits) },
    { name: "ASCII (Buchstaben, Zahlen, Sonderzeichen)", chars: uniqueChars(lowercase + uppercase + digits + commonSpecials) },
    { name: "Erweitert (ASCII + häufige Akzentzeichen)", chars: uniqueChars(lowercase + uppercase + digits + commonSpecials + accented) }
  ];

  var passwordInput = document.getElementById("passwordInput");
  var showPassword = document.getElementById("showPassword");
  var charsetSelect = document.getElementById("charsetSelect");
  var startBtn = document.getElementById("startBtn");
  var stopBtn = document.getElementById("stopBtn");
  var statusEl = document.getElementById("status");
  var timeLabel = document.getElementById("timeLabel");
  var attemptsLabel = document.getElementById("attemptsLabel");
  var currentAttempt = document.getElementById("currentAttempt");

  for (var c = 0; c < charsetOptions.length; c++) {
    var opt = document.createElement("option");
    opt.value = c;
    opt.text = charsetOptions[c].name;
    charsetSelect.appendChild(opt);
  }
  charsetSelect.selectedIndex = 2;

  showPassword.onclick = function () {
    passwordInput.type = showPassword.checked ? "text" : "password";
  };

  function setRunning(running) {
    passwordInput.readOnly = running;
    showPassword.disabled = running;
    charsetSelect.disabled = running;
    startBtn.disabled = running;
    stopBtn.disabled = !running;
  }

  function fmt(ms) {
    var minutes = Math.floor(ms / 60000);
    var seconds = Math.floor((ms % 60000) / 1000);
    var millis = ms % 1000;
    function pad(n, w) {
      n = String(n);
      while (n.length < w) n = "0" + n;
      return n;
    }
    return pad(minutes, 2) + ":" + pad(seconds, 2) + "." + pad(millis, 3);
  }

  var isRunning = false;
  var stopRequested = false;

  startBtn.onclick = function () {
    if (isRunning) return;

    var target = passwordInput.value;
    if (!target) {
      alert("Bitte zuerst ein Passwort eingeben.");
      return;
    }

    var selected = charsetOptions[charsetSelect.selectedIndex];
    var chars = selected.chars;

    for (var i = 0; i < target.length; i++) {
      if (chars.indexOf(target.charAt(i)) === -1) {
        alert("Das Passwort enthält Zeichen, die nicht im gewählten Zeichensystem enthalten sind.");
        return;
      }
    }

    isRunning = true;
    stopRequested = false;
    setRunning(true);

    statusEl.innerText = "Status: Läuft ...";
    timeLabel.innerText = "Zeit: 00:00.000";
    attemptsLabel.innerText = "Versuche: 0";
    currentAttempt.value = "";

    var startTs = new Date().getTime();
    var attempts = 0;
    var targetLen = target.length;
    var length = 1;
    var indices = new Array(length);
    for (var ii = 0; ii < length; ii++) indices[ii] = 0;
    var found = false;

    var timerId = setInterval(function () {
      timeLabel.innerText = "Zeit: " + fmt(new Date().getTime() - startTs);
    }, 50);

    function finish(stateText) {
      clearInterval(timerId);
      timeLabel.innerText = "Zeit: " + fmt(new Date().getTime() - startTs);
      attemptsLabel.innerText = "Versuche: " + attempts;
      statusEl.innerText = stateText;
      isRunning = false;
      setRunning(false);
    }

    function step() {
      if (stopRequested) {
        finish("Status: Abgebrochen");
        return;
      }

      var batch = 2500;
      while (batch-- > 0) {
        var candidate = "";
        for (var p = 0; p < length; p++) {
          candidate += chars.charAt(indices[p]);
        }

        attempts++;
        currentAttempt.value = candidate;
        if ((attempts % 200) === 0) {
          attemptsLabel.innerText = "Versuche: " + attempts;
        }

        if (candidate === target) {
          found = true;
          finish("Status: Passwort gefunden");
          return;
        }

        var pos = length - 1;
        while (pos >= 0) {
          indices[pos]++;
          if (indices[pos] < chars.length) break;
          indices[pos] = 0;
          pos--;
        }

        if (pos < 0) {
          length++;
          if (length > targetLen) {
            finish(found ? "Status: Passwort gefunden" : "Status: Nicht gefunden");
            return;
          }
          indices = new Array(length);
          for (var k = 0; k < length; k++) indices[k] = 0;
        }

        if (stopRequested) {
          finish("Status: Abgebrochen");
          return;
        }
      }

      setTimeout(step, 0);
    }

    setTimeout(step, 0);
  };

  stopBtn.onclick = function () {
    if (!isRunning) return;
    stopRequested = true;
  };
})();
</script>
</body>
</html>
